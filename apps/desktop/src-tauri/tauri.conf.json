{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Tiny Shrooms",
  "version": "1.0.19",
  "identifier": "fr.magicelian.tinyshrooms",
  "build": {
    "beforeDevCommand": "pnpm vite",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm vite build",
    "frontendDist": "../dist"
  },
  "app": {
    "macOSPrivateApi": true,
    "windows": [
      {
        "label": "main",
        "title": "Tiny Shrooms",
        "width": 320,
        "height": 320,
        "transparent": true,
        "acceptFirstMouse": true,
        "decorations": false,
        "shadow": false,
        "alwaysOnTop": true,
        "resizable": false,
        "skipTaskbar": true,
        "visibleOnAllWorkspaces": true
      }
    ],
    "trayIcon": {
      "id": "main",
      "iconPath": "icons/barre-menus.png",
      "iconAsTemplate": true,
      "tooltip": "Tiny Shrooms"
    },
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "app",
      "dmg",
      "nsis"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "createUpdaterArtifacts": true,
    "macOS": {
      "signingIdentity": "-",
      "minimumSystemVersion": "11.0"
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDc4MkU4QjcyNkUwNTY0MQpSV1JCVnVBbXQraUNCMG91WEl1Z0l4K1ZBdGhKSWtZWVBMaDZsZ0NyS1ArTmJqV2lDRjhXQnE0Mwo=",
      "endpoints": [
        "https://github.com/Magicelian/tiny-shrooms/releases/latest/download/latest.json"
      ]
    }
  }
}
